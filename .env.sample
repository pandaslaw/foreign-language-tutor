# Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ELEVENLABS_API_KEY=your_elevenlabs_api_key
OPENROUTER_API_KEY=your_openai_api_key
LANGUAGE_MODEL = openai/gpt-4o-mini-2024-07-18

# Database Configuration
DATABASE_URL=postgresql://<your-db-username>:<your-db-password>@<host_name>/<your-db-name>

# Environment
ENV=development
LOG_LEVEL=INFO
ENABLE_METRICS=1
DATA_RETENTION_DAYS=365
MAX_CONNECTIONS=10
REQUEST_TIMEOUT=30

# Admin Configuration
ADMIN_USER_IDS=123456789,987654321  # Comma-separated list of admin Telegram user IDs
